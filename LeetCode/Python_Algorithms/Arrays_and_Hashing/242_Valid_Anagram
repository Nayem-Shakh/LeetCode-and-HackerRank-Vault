"""
Problem: 242. Valid Anagram
Approach: Used the built-in collections.Counter to instantly generate and compare character frequency hash maps.

Time Complexity: O(N) where N is the length of the strings.
Space Complexity: O(1) because the hash map will never exceed 26 keys (for lowercase English letters).
"""

import collections

class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        if len(s) != len(t):
            return False
        
        return collections.Counter(s) == collections.Counter(t)
